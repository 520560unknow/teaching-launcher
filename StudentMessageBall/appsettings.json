{
  "WebApp": {
    "Url": "https://example.com",
    "WindowTitle": "教学系统",
    "WindowWidth": 1200,
    "WindowHeight": 800
  },
  "MessageService": {
    "Mode": "Polling",
    "WebSocketUrl": "wss://example.com/ws/messages",
    "PollingIntervalSeconds": 5,
    "ApiBaseUrl": "https://example.com/api",
    "MessagesEndpoint": "/messages",
    "AutoReconnect": true,
    "MaxReconnectAttempts": 10
  },
  "FloatingBall": {
    "Size": 80,
    "DefaultPositionX": null,
    "DefaultPositionY": null,
    "AlwaysOnTop": true,
    "BadgeMaxCount": 99
  },
  "Cache": {
    "MaxCachedMessages": 1000,
    "CacheFilePath": "cache_messages.json"
  },
  "App": {
    "AutoStart": false,
    "MinimizeToTray": true,
    "ShowBallOnStartup": true
  }
}