<Window x:Class="StudentMessageBall.Windows.WebAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="教学系统" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        MinWidth="600" MinHeight="400"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="4">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0">
                    <Button Content="←" Width="32" Height="28" Click="BtnBack_Click"
                            ToolTip="后退" Margin="0,0,2,0"/>
                    <Button Content="→" Width="32" Height="28" Click="BtnForward_Click"
                            ToolTip="前进" Margin="0,0,2,0"/>
                    <Button Content="↻" Width="32" Height="28" Click="BtnRefresh_Click"
                            ToolTip="刷新" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtUrl" VerticalAlignment="Center"
                               Text="加载中..." Foreground="#666"
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               MaxWidth="400"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚙" Width="32" Height="28" Click="BtnSettings_Click"
                            ToolTip="设置" Margin="0,0,2,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 区域 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"
                          NavigationCompleted="WebView_NavigationCompleted"
                          NavigationStarting="WebView_NavigationStarting"/>

            <!-- 加载失败覆盖层 -->
            <Border x:Name="ErrorOverlay" Background="#F5F5F5" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="48" HorizontalAlignment="Center" Foreground="#FF9800"/>
                    <TextBlock x:Name="TxtError" Text="页面加载失败"
                               FontSize="16" HorizontalAlignment="Center"
                               Margin="0,12,0,8" Foreground="#333"/>
                    <TextBlock x:Name="TxtErrorDetail" Text="请检查网络连接或系统地址配置"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="#999" TextWrapping="Wrap" MaxWidth="400"/>
                    <Button Content="重试" Width="100" Height="32" Margin="0,16,0,0"
                            Click="BtnRetry_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="11"
                           Foreground="#888" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>