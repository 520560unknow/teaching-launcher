<Window x:Class="StartMode.Windows.WebAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="课堂互动系统"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Padding="8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnBack" Content="← 上一页" 
                        Width="80" Height="28" Margin="0,0,6,0"
                        Click="BtnBack_Click"
                        IsEnabled="False"
                        Cursor="Hand"/>
                <Button x:Name="BtnHome" Content="🏠 主页面" 
                        Width="80" Height="28" Margin="0,0,6,0"
                        Click="BtnHome_Click"
                        Cursor="Hand"/>
                <TextBlock x:Name="UrlText" 
                           VerticalAlignment="Center" 
                           FontSize="11" Foreground="#666"
                           Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="900"/>
            </StackPanel>
        </Border>

        <!-- 加载进度条 -->
        <ProgressBar x:Name="LoadingProgress" 
                     Grid.Row="1"
                     Height="3" 
                     VerticalAlignment="Top" 
                     IsIndeterminate="True" 
                     Visibility="Visible"/>
        
        <!-- WebView2 控件 -->
        <wv2:WebView2 x:Name="WebView" 
                      Grid.Row="1"
                      NavigationStarting="WebView_NavigationStarting"
                      NavigationCompleted="WebView_NavigationCompleted"
                      CoreWebView2InitializationCompleted="WebView_CoreWebView2InitializationCompleted"/>
        
        <!-- 加载错误提示 -->
        <Border x:Name="ErrorPanel" 
                Grid.Row="1"
                Background="#FFF3F3F3" 
                Visibility="Collapsed"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                <TextBlock Text="&#xE783;" 
                           FontFamily="Segoe MDL2 Assets" 
                           FontSize="48" 
                           Foreground="#FF999999"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="页面加载失败" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="#FF333333"
                           Margin="0,10,0,5"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorText"
                           Text="请检查 Java 环境和 JAR 文件是否存在" 
                           FontSize="14" 
                           Foreground="#FF666666"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"/>
                <Button Content="重试" 
                        Width="120" 
                        Height="36"
                        Margin="0,20,0,0"
                        Click="RetryButton_Click"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            </StackPanel>
        </Border>
        
        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#FFF0F0F0" 
                Padding="8,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" 
                           Text="就绪" 
                           FontSize="11" 
                           Foreground="#FF666666"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
