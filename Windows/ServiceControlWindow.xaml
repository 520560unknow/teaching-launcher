<Window x:Class="StartMode.Windows.ServiceControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务控制"
        Width="340" Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#FF1F2430" CornerRadius="12"
            BorderBrush="#4400E5FF" BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="服务控制" Foreground="#E6F7FF" FontSize="15" FontWeight="SemiBold"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        Width="24" Height="24" Background="Transparent" Foreground="#8899AA"
                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
            </Grid>

            <!-- 网页服务 -->
            <Border Grid.Row="1" Background="#FF2A3140" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="WebStatusDot" Grid.Column="0" Width="9" Height="9"
                             Fill="#777777" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="网页服务" Foreground="#E6F7FF" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WebStatusText" Text="检测中…" Foreground="#8899AA" FontSize="11"/>
                    </StackPanel>

                    <Button x:Name="BtnWebStart" Grid.Column="2" Content="启动" Click="WebStart_Click"
                            Width="52" Height="28" Margin="0,0,8,0" Cursor="Hand"
                            Background="#FF2E7D32" Foreground="White" BorderThickness="0" FontSize="12"/>
                    <Button x:Name="BtnWebStop" Grid.Column="3" Content="关闭" Click="WebStop_Click"
                            Width="52" Height="28" Cursor="Hand"
                            Background="#FFB33A3A" Foreground="White" BorderThickness="0" FontSize="12"/>
                </Grid>
            </Border>

            <!-- AI 服务 -->
            <Border Grid.Row="2" Background="#FF2A3140" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="AiStatusDot" Grid.Column="0" Width="9" Height="9"
                             Fill="#777777" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="AI 服务（本地模型）" Foreground="#E6F7FF" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AiStatusText" Text="检测中…" Foreground="#8899AA" FontSize="11"/>
                    </StackPanel>

                    <Button x:Name="BtnAiStart" Grid.Column="2" Content="启动" Click="AiStart_Click"
                            Width="52" Height="28" Margin="0,0,8,0" Cursor="Hand"
                            Background="#FF2E7D32" Foreground="White" BorderThickness="0" FontSize="12"/>
                    <Button x:Name="BtnAiStop" Grid.Column="3" Content="关闭" Click="AiStop_Click"
                            Width="52" Height="28" Cursor="Hand"
                            Background="#FFB33A3A" Foreground="White" BorderThickness="0" FontSize="12"/>
                </Grid>
            </Border>

            <TextBlock x:Name="HintText" Grid.Row="3" Text="关闭会结束进程并释放端口"
                       Foreground="#667788" FontSize="10" Margin="2,10,0,0"/>
        </Grid>
    </Border>
</Window>
