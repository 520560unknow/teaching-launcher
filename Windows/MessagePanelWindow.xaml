<Window x:Class="StartMode.Windows.MessagePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:StartMode.Converters"
        Title="学生消息"
        Width="350" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">
    
    <Border Background="White" 
            CornerRadius="10"
            BorderBrush="#FFE0E0E0" 
            BorderThickness="1"
            Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" 
                    Background="#FF2196F3" 
                    CornerRadius="9,9,0,0"
                    Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="学生消息" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal">
                        <Button x:Name="MarkAllReadButton" 
                                Content="全部已读" 
                                Background="Transparent" 
                                Foreground="White" 
                                BorderThickness="0"
                                FontSize="12"
                                Click="MarkAllRead_Click"
                                Padding="5,2"
                                Cursor="Hand"/>
                        <Button x:Name="CloseButton" 
                                Content="✕" 
                                Background="Transparent" 
                                Foreground="White" 
                                BorderThickness="0"
                                FontSize="14"
                                Click="Close_Click"
                                Padding="5,2"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 筛选标签 -->
            <Border Grid.Row="1" 
                    Background="#FFF5F5F5" 
                    Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" 
                                 Content="全部" 
                                 IsChecked="True"
                                 Style="{StaticResource FilterRadioStyle}"
                                 Click="Filter_Click"/>
                    <RadioButton x:Name="FilterComment" 
                                 Content="评论" 
                                 Style="{StaticResource FilterRadioStyle}"
                                 Click="Filter_Click"/>
                    <RadioButton x:Name="FilterDanmaku" 
                                 Content="弹幕" 
                                 Style="{StaticResource FilterRadioStyle}"
                                 Click="Filter_Click"/>
                    <RadioButton x:Name="FilterOpinion" 
                                 Content="观点" 
                                 Style="{StaticResource FilterRadioStyle}"
                                 Click="Filter_Click"/>
                </StackPanel>
            </Border>
            
            <!-- 消息列表 -->
            <ScrollViewer Grid.Row="2" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MessageList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsUnread, Converter={StaticResource UnreadToBackgroundConverter}}"
                                    BorderBrush="#FFE0E0E0" 
                                    BorderThickness="0,0,0,1"
                                    Padding="12,10"
                                    Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- 学生姓名和消息类型 -->
                                    <StackPanel Grid.Row="0" 
                                                Grid.Column="0" 
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding StudentName}" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF333333"/>
                                        <Border Background="{Binding TypeColor}" 
                                                CornerRadius="3"
                                                Padding="5,1"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TypeName}" 
                                                       Foreground="White" 
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- 时间 -->
                                    <TextBlock Grid.Row="0" 
                                               Grid.Column="1"
                                               Text="{Binding TimeDisplay}" 
                                               FontSize="11" 
                                               Foreground="#FF999999"
                                               VerticalAlignment="Center"/>
                                    
                                    <!-- 消息内容 -->
                                    <TextBlock Grid.Row="1" 
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Content}" 
                                               FontSize="13"
                                               Foreground="#FF555555"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                    
                                    <!-- 来源 -->
                                    <TextBlock Grid.Row="2" 
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Source, StringFormat='来源: {0}'}" 
                                               FontSize="11" 
                                               Foreground="#FFAAAAAA"
                                               Margin="0,3,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- 空状态提示 -->
            <StackPanel Grid.Row="2" 
                        x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <TextBlock Text="&#xE783;" 
                           FontFamily="Segoe MDL2 Assets" 
                           FontSize="48" 
                           Foreground="#FFCCCCCC"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="暂无消息" 
                           FontSize="16" 
                           Foreground="#FF999999"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            
            <!-- 底部状态栏 -->
            <Border Grid.Row="3" 
                    Background="#FFF5F5F5" 
                    CornerRadius="0,0,9,9"
                    Padding="12,8">
                <TextBlock x:Name="StatusText" 
                           Text="共 0 条消息" 
                           FontSize="11" 
                           Foreground="#FF999999"/>
            </Border>
        </Grid>
    </Border>
    
    <Window.Resources>
        <!-- 筛选按钮样式 -->
        <Style x:Key="FilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12"
                                Padding="12,4"
                                Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#FF2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#FFE0E0E0"/>
                                <Setter Property="Foreground" Value="#FF666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 未读消息背景转换器 -->
        <converters:UnreadToBackgroundConverter x:Key="UnreadToBackgroundConverter"/>
    </Window.Resources>
</Window>
