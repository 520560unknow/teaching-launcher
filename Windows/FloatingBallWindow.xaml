<Window x:Class="StartMode.Windows.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="悬浮球"
        Width="300" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Left="100" Top="100"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Grid x:Name="MainGrid" Width="300" Height="300">
        <Grid.Resources>
            <!-- 消息提醒动画 -->
            <Storyboard x:Key="MessageAnimation">
                <DoubleAnimation Storyboard.TargetName="MainBall" 
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 From="1" To="1.1" Duration="0:0:0.1" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="MainBall" 
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="1" To="1.1" Duration="0:0:0.1" AutoReverse="True"/>
            </Storyboard>
            
            <!-- 气泡显示动画 -->
            <Storyboard x:Key="BubbleShowAnimation">
                <DoubleAnimation Storyboard.TargetName="MessageBubble" 
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>
            
            <!-- 气泡隐藏动画 -->
            <Storyboard x:Key="BubbleHideAnimation">
                <DoubleAnimation Storyboard.TargetName="MessageBubble" 
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.3"/>
            </Storyboard>
            
            <!-- 子悬浮球模板 -->
            <ControlTemplate x:Key="SubBallTemplate" TargetType="Button">
                <Border Background="{TemplateBinding Background}" 
                        CornerRadius="30"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Grid.Resources>
        
        <!-- 主圆形按钮（中心位置） -->
        <Ellipse x:Name="MainBall" 
                 Width="80" Height="80" 
                 Fill="#2196F3" 
                 Stroke="#1976D2" 
                 StrokeThickness="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 MouseLeftButtonDown="MainBall_MouseLeftButtonDown"
                 MouseRightButtonDown="MainBall_MouseRightButtonDown"
                 Cursor="Hand"
                 Panel.ZIndex="10">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
            </Ellipse.Effect>
            <Ellipse.ContextMenu>
                <ContextMenu x:Name="BallContextMenu">
                    <MenuItem Header="显示/隐藏悬浮球" Click="ToggleVisibility_Click"/>
                    <MenuItem Header="服务控制（网页 / AI）" Click="ServiceControl_Click"/>
                    <MenuItem Header="退出程序" Click="ExitApp_Click"/>
                </ContextMenu>
            </Ellipse.ContextMenu>
        </Ellipse>
        
        <!-- 中心图标 -->
        <Path x:Name="CenterIcon"
              Data="M20,4 C28.84,4 36,11.16 36,20 C36,28.84 28.84,36 20,36 C11.16,36 4,28.84 4,20 C4,11.16 11.16,4 20,4 M20,8 C13.37,8 8,13.37 8,20 C8,26.63 13.37,32 20,32 C26.63,32 32,26.63 32,20 C32,13.37 26.63,8 20,8 M18,14 L18,22 L26,18 Z"
              Fill="White"
              Width="24" Height="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Panel.ZIndex="11"/>
        
        <!-- 消息角标 -->
        <Border x:Name="MessageBadge" 
                Background="#FF4444" 
                CornerRadius="10" 
                MinWidth="20" 
                MinHeight="20" 
                Padding="5,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="30,-30,0,0"
                Visibility="Collapsed"
                MouseLeftButtonDown="MessageBadge_MouseLeftButtonDown"
                Cursor="Hand"
                ToolTip="点击查看消息"
                Panel.ZIndex="12">
            <TextBlock x:Name="BadgeCount" 
                       Text="0" 
                       Foreground="White" 
                       FontSize="12" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        
        <!-- 新消息提示气泡 -->
        <Border x:Name="MessageBubble" 
                Background="#4CAF50" 
                CornerRadius="8" 
                Padding="10,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,80,0,0"
                Visibility="Collapsed"
                Panel.ZIndex="12">
            <TextBlock x:Name="BubbleText" 
                       Text="" 
                       Foreground="White" 
                       FontSize="12"
                       MaxWidth="150"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
        
        <!-- 子悬浮球容器 -->
        <StackPanel x:Name="SubBallsPanel"
                    Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="0,0,220,0"
                    Visibility="Collapsed"
                    Panel.ZIndex="9">
            
            <!-- 子悬浮球1：打开课堂互动系统 -->
            <Button x:Name="SubBall1" 
                    Width="60" Height="60" 
                    Click="SubBall1_Click"
                    Cursor="Hand"
                    Margin="0,0,0,10"
                    Template="{StaticResource SubBallTemplate}">
                <Button.Background>
                    <SolidColorBrush Color="#4CAF50"/>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Button.Effect>
                <TextBlock Text="打开课堂&#x0a;互动系统"
                           Foreground="White"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>
            
            <!-- 子悬浮球2：打开信息显示 -->
            <Button x:Name="SubBall2" 
                    Width="60" Height="60" 
                    Click="SubBall2_Click"
                    Cursor="Hand"
                    Template="{StaticResource SubBallTemplate}">
                <Button.Background>
                    <SolidColorBrush Color="#FF9800"/>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Button.Effect>
                <TextBlock Text="打开&#x0a;信息显示"
                           Foreground="White"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>

            <!-- 子悬浮球3：服务控制（启动/关闭网页与 AI） -->
            <Button x:Name="SubBall3" 
                    Width="60" Height="60" 
                    Click="SubBall3_Click"
                    Cursor="Hand"
                    Template="{StaticResource SubBallTemplate}">
                <Button.Background>
                    <SolidColorBrush Color="#9C27B0"/>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Button.Effect>
                <TextBlock Text="服务&#x0a;控制"
                           Foreground="White"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
